{
  "manifest_version": 2,
  "name": "Terminal Basic Theme",
  "version": "2.0",
  "description": "Portable Terminal Basic compatible palette generated by dotfiles",
  "permissions": ["theme"],
  "background": {
    "scripts": ["themes.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "e-ink-theme@breadnet",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
