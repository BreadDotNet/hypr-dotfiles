# Portable dark variant based on the visual character of Terminal Pro.
# It shares the repository's Terminal-compatible ANSI palette with Basic.

THEME_BASE='terminal-macos'
THEME_APPEARANCE='dark'
THEME_ALTERNATE='terminal-basic'

BACKGROUND='#000000'
FOREGROUND='#F2F2F2'
CURSOR='#E6E600'
SELECTION='#414141'

COLOR_PRIMARY="${FOREGROUND}"
COLOR_EMPHASIZED="${FOREGROUND}"
COLOR_SURFACE="${SELECTION}"
COLOR_OVERLAY="${ANSI_8}"
