# Portable light variant compatible with the traditional Terminal Basic look.

THEME_BASE='terminal-macos'
THEME_APPEARANCE='light'
THEME_ALTERNATE='terminal-basic-dark'

BACKGROUND='#FFFFFF'
FOREGROUND='#000000'
CURSOR='#7F7F7F'
SELECTION='#BFBFBF'

COLOR_PRIMARY="${FOREGROUND}"
# Bright white has insufficient contrast on this light background.
COLOR_EMPHASIZED="${ANSI_0}"
COLOR_SURFACE="${ANSI_15}"
COLOR_OVERLAY="${ANSI_7}"
COLOR_CURSOR_TEXT="${BACKGROUND}"
COLOR_ACTIVE_BG="${COLOR_EMPHASIZED}"
COLOR_ACTIVE_FG="${BACKGROUND}"
COLOR_ON_ACCENT="${BACKGROUND}"
