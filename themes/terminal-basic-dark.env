# Portable dark appearance of the dynamic macOS Terminal Basic profile.

THEME_BASE='terminal-basic-dark'
THEME_APPEARANCE='dark'
THEME_ALTERNATE='terminal-basic'

BACKGROUND='#1E1E1E'
FOREGROUND='#FFFFFF'
CURSOR='#9D9D9D'
SELECTION='#3F638B'

COLOR_PRIMARY="${FOREGROUND}"
COLOR_EMPHASIZED="${ANSI_15}"
COLOR_SURFACE="${ANSI_0}"
COLOR_OVERLAY="${SELECTION}"
COLOR_CURSOR_TEXT="${FOREGROUND}"
COLOR_ACTIVE_BG="${SELECTION}"
COLOR_ACTIVE_FG="${FOREGROUND}"
COLOR_ON_ACCENT="${FOREGROUND}"
