# Portable sRGB capture of the macOS Terminal Basic profile in dark appearance.
# Terminal.app uses dynamic system colors, so these values are compatibility
# values rather than a pixel-identical rendering guarantee.

ANSI_0='#000000'
ANSI_1='#D6492E'
ANSI_2='#42C732'
ANSI_3='#B8B72F'
ANSI_4='#6A42F6'
ANSI_5='#E44CE1'
ANSI_6='#41C4D1'
ANSI_7='#D1D1D1'
ANSI_8='#909090'
ANSI_9='#FF4B29'
ANSI_10='#39ED2A'
ANSI_11='#EFEF1C'
ANSI_12='#DA97FF'
ANSI_13='#FF4CFF'
ANSI_14='#32F4F4'
ANSI_15='#EDEDED'

# Semantic colors retain the Basic palette's ordinary ANSI relationships.
COLOR_ERROR="${ANSI_1}"
COLOR_SUCCESS="${ANSI_2}"
COLOR_WARNING="${ANSI_3}"
COLOR_INFO="${ANSI_6}"
COLOR_ACCENT="${ANSI_4}"
COLOR_MUTED="${ANSI_8}"
COLOR_DIRECTORY="${ANSI_4}"
COLOR_LINK="${ANSI_6}"
COLOR_STRING="${ANSI_5}"
COLOR_COMMENT="${ANSI_8}"
COLOR_ADDED="${ANSI_2}"
COLOR_MODIFIED="${ANSI_3}"
COLOR_DELETED="${ANSI_1}"
