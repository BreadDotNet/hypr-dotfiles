# 16-color palette used by the portable Terminal Basic light variant.
# These values intentionally describe the repository's compatibility palette;
# they are not a claim about pixel-identical rendering by Terminal.app.

ANSI_0='#000000'
ANSI_1='#990000'
ANSI_2='#00A600'
ANSI_3='#999900'
ANSI_4='#0000B2'
ANSI_5='#B200B2'
ANSI_6='#00A6B2'
ANSI_7='#BFBFBF'
ANSI_8='#666666'
ANSI_9='#E50000'
ANSI_10='#00D900'
ANSI_11='#E5E500'
ANSI_12='#0000FF'
ANSI_13='#E500E5'
ANSI_14='#00E5E5'
ANSI_15='#E5E5E5'

# Central semantic scheme. These names do not redefine ANSI behavior.
COLOR_ERROR="${ANSI_1}"
COLOR_SUCCESS="${ANSI_2}"
COLOR_WARNING="${ANSI_3}"
COLOR_INFO="${ANSI_6}"
COLOR_ACCENT="${ANSI_4}"
COLOR_MUTED="${ANSI_8}"
COLOR_DIRECTORY="${ANSI_4}"
COLOR_LINK="${ANSI_6}"
COLOR_STRING="${ANSI_5}"
COLOR_COMMENT="${ANSI_8}"
COLOR_ADDED="${ANSI_2}"
COLOR_MODIFIED="${ANSI_3}"
COLOR_DELETED="${ANSI_1}"
